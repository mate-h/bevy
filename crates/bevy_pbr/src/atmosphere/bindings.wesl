import bevy_render::view::View;

import package::{
    render::mesh_view_types::Lights,
    atmosphere::types::{Atmosphere, AtmosphereSettings, AtmosphereTransforms},
    light_probe::environment_sh::EnvironmentMapSh,
};

@group(0) @binding(0) var<uniform> atmosphere: Atmosphere;
@group(0) @binding(1) var<uniform> settings: AtmosphereSettings;
@group(0) @binding(2) var<uniform> atmosphere_transforms: AtmosphereTransforms;
@group(0) @binding(3) var<uniform> view: View;
@group(0) @binding(4) var<uniform> lights: Lights;

@group(0) @binding(5) var medium_density_lut: texture_2d<f32>;
@group(0) @binding(6) var medium_scattering_lut: texture_2d<f32>;
@group(0) @binding(7) var medium_sampler: sampler;

@group(0) @binding(8) var transmittance_lut: texture_2d<f32>;
@group(0) @binding(9) var multiscattering_lut: texture_2d<f32>;
@group(0) @binding(10) var sky_view_lut: texture_2d<f32>;
@group(0) @binding(11) var aerial_view_lut: texture_3d<f32>;
@group(0) @binding(12) var atmosphere_lut_sampler: sampler;
// Clear-sky irradiance on the ground per unit sun illuminance, by the cosine of the sun's zenith
// angle there (`ground_irradiance_lut.wesl`); read by the sky-view LUT for the ground's skylight.
@group(0) @binding(62) var ground_irradiance_lut: texture_2d<f32>;

// Cloud shadow map (front depth + extinction stats) generated by a compute pass.
// Encodes:
// - R: front depth (meters) from the light-volume near plane
// - G: mean extinction (1/m)
// - B: max optical depth (unitless)
@group(0) @binding(23) var cloud_shadow_map: texture_2d<f32>;

// Cloud field (`cloud_field.wesl`): r = signed distance (m), g = blurred cloud column optical
// depth (cloud AO for ground skylight).
@group(0) @binding(44) var cloud_field_sdf: texture_3d<f32>;

// The sky's spherical harmonics: the atmosphere probe's `EnvironmentMapSh`
// (`light_probe/environment_sh.wesl`), the raymarched sky with its clouds as seen from the
// camera, projected once per frame; pre-exposed like the sky-view LUT (the probe's exposure is
// the view's that renders it). One global probe: the irradiance at the camera, not at a cloud's
// altitude. Zero without a probe. Read by the cloud field's diffusion solve (CLOUD_SKY_SH_BOUNDARY).
@if(CLOUD_SKY_SH_BOUNDARY)
@group(0) @binding(66) var<storage, read> sky_sh: EnvironmentMapSh;
// Diffuse sky and ground light of the cloud field (`cloud_field.wesl` diffusion_publish):
// rgb = 4 pi J pre-exposed, a = 1 where the solve has a value (0 far from cloud), so rgb / a is
// the solution interpolated over the cells that have one.
@if(CLOUD_SKY_SH_BOUNDARY)
@group(0) @binding(68) var cloud_field_diff_amb: texture_3d<f32>;

// Spatio-temporal blue noise for per-frame stratification
@if(CLOUDS_ENABLED)
@group(0) @binding(25) var stbn_texture: texture_2d_array<f32>;
